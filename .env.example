# Kopieer naar .env voor lokaal gebruik (.env staat in .gitignore). Op Netlify zet je deze als environment variables.
OPENROUTER_API_KEY=
# Optioneel: ander (goedkoop) model, standaard google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Reservemodel bij rate limits (429) van het eerste model
# OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
# Alleen nodig voor de webapp:
APP_PASSWORD=
# Optioneel: aparte sleutel voor de sessiecookie (standaard wordt APP_PASSWORD gebruikt)
# SESSION_SECRET=
